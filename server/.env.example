PORT=5000
NODE_ENV=development
# MongoDB URI (If empty or unreachable in development, automatically uses embedded MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/insureflow?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
CLIENT_URL=http://localhost:5173
OCR_PROVIDER=hybrid
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
